---
import { Button, Collapse, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'sites', text: '网站' },
  { depth: 2, slug: 'tools', text: '小工具与实验' },
  { depth: 2, slug: 'credits', text: '致谢' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>
    这里收录我做过和在维护的小东西。比起"项目"，更像是一些把想法变成现实的练习。
  </p>

  <h2 id='sites'>网站</h2>
  <ProjectSection
    projects={[
      {
        name: '📖 拾光集',
        description: '本站——用 Astro Theme Pure 模板搭建的清新博客，写随笔、工具心得与游戏杂谈',
        links: [
          { type: 'site', href: 'https://pure-shiguang.pages.dev/' },
          { type: 'github', href: 'https://github.com/mikucy7/blogs' }
        ]
      },
      {
        name: '🌌 Dairy://OS',
        description: '从零手写的科技风个人档案库，存放日记与随想，带口令门禁与全文检索',
        links: [{ type: 'site', href: 'https://dairy-os.pages.dev/' }]
      }
    ]}
  />

  <h2 id='tools'>小工具与实验</h2>
  <ProjectSection
    projects={[
      {
        name: '📝 课程评测合集',
        description: '给后来人的课程体验记录：收获、任务量、分数与避坑提醒',
        links: [{ type: 'site', href: '/blog' }]
      },
      {
        name: '🎲 抽卡概率笔记',
        description: '用期望值计算拆解二游保底机制的小数学',
        links: [{ type: 'site', href: '/blog/gacha-math' }]
      }
    ]}
  />

  <h2 id='credits'>致谢</h2>
  <ProjectSection
    projects={[
      {
        name: '🎨 Astro Theme Pure',
        description: '本站使用的博客主题，简洁、快速而强大',
        links: [
          { type: 'github', href: 'https://github.com/cworld1/astro-theme-pure' },
          { type: 'site', href: 'https://astro-pure.js.org/' }
        ]
      },
      {
        name: '✨ Arthals\' ink',
        description: '让我决定走上这条路线的灵感来源',
        links: [{ type: 'site', href: 'https://arthals.ink/' }]
      }
    ]}
  />
</PageLayout>
